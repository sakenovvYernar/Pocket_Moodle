PORT=3001
JWT_SECRET=replace_with_long_random_secret
CORS_ORIGIN=*

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=700
GEMINI_TEMPERATURE=0.5
AI_WEB_SEARCH_TIMEOUT_MS=4500

# Telegram bot. Empty token disables the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEZONE=Asia/Almaty
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=*/10 * * * *

# Server-side DU bearer token used only by cache sync jobs.
# DU_TOKEN=your_du_bearer_token
# Optional secret required in X-DU-Sync-Secret for sync endpoints.
# If empty, any authenticated user can run sync in local/dev.
# DU_SYNC_SECRET=replace_with_random_sync_secret
# Optional comma-separated DU login endpoint candidates, if DU changes auth path.
# DU_AUTH_LOGIN_PATHS=/astanait-authorization-module/api/v1/auth/login

# Firebase Admin SDK.
# Use one of these options:
# 1) JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 2) Base64 encoded JSON, recommended for deploy dashboards
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# 3) Local file path, for development only
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Optional: only for one-time migration from old MongoDB
# MONGODB_URI=mongodb+srv://user:password@cluster/db
# MONGODB_DB=aitu
